      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Severity 1 (Count)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "P2A13252C41BAC6F2"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH bounds AS (\n    SELECT MIN(time) AS t0\n    FROM dp_mag1\n),\n\nairport_mean AS (\n    SELECT\n        m.origin,\n        SUM(m.delay_count) * 60.0 / 2880.0 AS mean_magnitude\n    FROM dp_mag1 AS m\n    CROSS JOIN bounds\n    WHERE m.time >= bounds.t0\n      AND m.time < bounds.t0 + INTERVAL '2880 minutes'\n    GROUP BY m.origin\n),\n\nabove_mean AS (\n    SELECT\n        m.origin,\n        m.time\n    FROM dp_mag1 AS m\n    CROSS JOIN bounds\n    JOIN airport_mean AS a\n        ON m.origin = a.origin\n    WHERE m.time >= bounds.t0\n      AND m.time < bounds.t0 + INTERVAL '2880 minutes'\n      AND a.mean_magnitude > 0\n      AND m.delay_count >= a.mean_magnitude\n)\n\nSELECT\n    origin,\n    EXTRACT(EPOCH FROM (MAX(time) - MIN(time))) / 3600.0 AS severity\nFROM above_mean\nGROUP BY origin\nORDER BY severity DESC\nLIMIT 10",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [
                                {
                                  "name": "airport",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            },
                            {
                              "parameters": [
                                {
                                  "name": "severity",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ]
                        },
                        "table": "dp_sev1"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
